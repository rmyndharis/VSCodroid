    <string name="key_desc_left_bracket">Corchete izquierdo</string>
    <string name="key_desc_right_bracket">Corchete derecho</string>
    <string name="key_desc_less_than">Menor que</string>
    <string name="key_desc_greater_than">Mayor que</string>
    <string name="key_desc_equals">Igual</string>
    <string name="key_desc_exclamation">Signo de exclamación</string>
    <string name="key_desc_hash">Numeral</string>
    <string name="key_desc_at_sign">Arroba</string>
    <string name="key_desc_f1">Tecla de función F1</string>
    <string name="key_desc_f2">Tecla de función F2</string>
    <string name="key_desc_f3">Tecla de función F3</string>
    <string name="key_desc_f4">Tecla de función F4</string>
    <string name="key_desc_f5">Tecla de función F5</string>
    <string name="key_desc_f6">Tecla de función F6</string>
    <string name="key_desc_f7">Tecla de función F7</string>
    <string name="key_desc_f8">Tecla de función F8</string>
