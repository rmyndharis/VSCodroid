<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">VSCodroid</string>
    <string name="notification_channel_name">Servidor do VSCodroid</string>
    <string name="notification_channel_description">Mantém o servidor de desenvolvimento local em execução</string>
    <string name="notification_title">O VSCodroid está em execução</string>
    <!-- The card the service puts up while first-run setup unpacks. Its own pair
         rather than the server's, because no server is running yet and the whole
         point of the hold is that the process survives a user who leaves. -->
    <string name="notification_title_setup">Configurando o VSCodroid</string>
    <string name="notification_text_setup">Descompactando o editor e suas ferramentas. Isso leva alguns minutos e acontece só uma vez.</string>
    <string name="notification_text">Servidor de desenvolvimento local ativo</string>
    <!-- There was a second line here, shown when the server was adopted rather
         than started, telling the user the session had no network and to tap
         Stop. It was true while `assets/server.js` bound the DNS proxy inside
         the bootstrap: an adopted server is by construction one whose bootstrap
         is gone, so it went on pointing HTTPS_PROXY at a closed port and every
         terminal, git and npm inherited the dead address. The proxy is now
         preloaded into the child that bootstrap forks and lives exactly as long
         as it does, so an adopted server carries a working one and there is
         nothing left to say. Read those two files before adding a line back;
         `NodeService.degradableNotificationText` names the same check. -->
    <string name="action_stop">Parar o servidor</string>

    <!-- Shown once the automatic restart budget is spent. Replaces the two
         strings above in the same notification, which then carries no Stop
         action because there is nothing left to stop. -->
    <string name="notification_title_stopped">O servidor do VSCodroid parou</string>
    <string name="notification_text_stopped">O servidor falhou várias vezes seguidas. Reinicie o app.</string>
    <string name="extracting_message">Extraindo os arquivos principais\u2026</string>

    <!-- The steps first-run setup reports while it unpacks, shown under the
         progress bar on the splash screen. They are also the %1$s in
         [error_setup_failed_at], which names the step that failed, so a
         translation lands in two places at once. describeFailure trims a
         trailing period, space or ellipsis off the name before quoting it. -->
    <string name="setup_step_directories">Criando diretórios\u2026</string>
    <string name="setup_step_server">Extraindo os arquivos do servidor\u2026</string>
    <string name="setup_step_bootstrap">Extraindo o bootstrap do servidor\u2026</string>
    <string name="setup_step_tools">Extraindo as ferramentas\u2026</string>
    <string name="setup_step_git">Preparando o git\u2026</string>
    <string name="setup_step_symlinks">Preparando as ferramentas\u2026</string>
    <string name="setup_step_extensions">Preparando as extensões\u2026</string>
    <string name="setup_step_environment">Configurando o ambiente\u2026</string>
    <string name="setup_step_done">Concluído!</string>
    <string name="error_server_start">Não foi possível iniciar o servidor de desenvolvimento</string>
    <string name="error_server_timeout">O servidor demorou demais para iniciar</string>

    <!-- Deliberately not an error_ string, and deliberately not the wording of
         the one above it. This is said while the server is still being waited
         for and may still come up, so it must not read as an ending: the app
         goes on asking after saying it, and the editor opens if an answer
         arrives. Borrowing the terminal wording would make a slow start
         indistinguishable from a dead one to everyone downstream.

         It also has to survive being read later. The next activity to bind
         reads it through NodeService.lastStartupNotice() with no idea how long
         ago it was recorded, so it says nothing about elapsed time. -->
    <string name="status_server_slow_start">O servidor de desenvolvimento está demorando mais que o normal para iniciar. O editor vai abrir assim que ele estiver pronto.</string>
    <string name="status_updating_python">Atualizando o Python…</string>
    <!-- Says what happened and what to do about it, and deliberately does not
         claim to have diagnosed anything. The app cannot tell an out-of-memory
         kill from a phantom-process one: both arrive as the same exit code and
         nothing here reads exit reasons. So the wording is "was turned off after
         repeated crashes", not "was too much memory", because the second would be
         a diagnosis the app did not make.

         Naming the setting matters more than it looks. The value lives in
         settings.json inside the editor, which is the surface this message is
         about to become reachable again, and a user who is not told which
         setting to look for has nothing to search on. -->
    <string name="heap_override_suspended">O limite de memória personalizado no settings.json foi desativado após falhas repetidas. Altere vscodroid.server.heapCeilingMb e reinicie o app para tentar outro valor.</string>
    <!-- The figure is passed in rather than written here, and it is the
         SHORTFALL the refusal measured, not the size of the unpack: this asks
         the user to free it, and what they have to free is what the device is
         missing. A fixed 500 MB outlived the tree it was measured against and
         sent people to free half of what unpacking needs, so they cleared space,
         came back, and failed in the same place. Quoting the whole demand had
         the mirror image of that fault, sending someone 200 MB short after 873.
         See FirstRunSetup.storageToFreeMb().

         It ends by naming the button, like its two siblings below. The failure
         screen adds Retry after the fact and does not move accessibility focus
         to it, so this announcement is the only place a screen reader user is
         told the button is there; "try again" left them looking for a gesture
         that does not exist. -->
    <string name="error_storage_full">Espaço de armazenamento insuficiente. Libere pelo menos %1$d MB e toque em Repetir.</string>
    <string name="error_setup_failed">A configuração falhou. Toque em Repetir ou reinstale o app.</string>
    <!-- The same failure when setup knows which step it died on. Names the step
         and quotes the exception, because the audience is developers and the
         next thing they do is either free some space or file the message. The
         version without a cause stays for a failure that happens before the
         first progress report. -->
    <string name="error_setup_failed_at">A configuração falhou durante: %1$s\n\n%2$s\n\nToque em Repetir ou reinstale o app se o erro continuar.</string>

    <!-- A tap on a link this app handed to Android that no app took. Names the
         scheme rather than the whole address, which can be long and can carry a
         token, and says the one thing the user can act on: nothing here is
         broken, there is simply nothing installed that opens this kind of link. -->
    <string name="url_handoff_no_app">Nenhum app instalado abre links %1$s.</string>
    <!-- The same tap failing for any other reason: a file:// URI Android refuses
         to expose, a content:// without a grant, anything else. The exception
         type is quoted because the audience is developers and it is the part
         worth putting in a bug report. -->
    <string name="url_handoff_failed">Não foi possível abrir esse link %1$s (%2$s).</string>

    <!-- A page inside the editor asked for an https address the WebView would not
         load: a dev server previewed in the Simple Browser, an image in a preview,
         a fetch from an extension's webview. The request was already refused
         before these strings existed; what was missing was any word about it, so
         the frame simply came up empty.

         Each cause gets its own wording because each needs a different next step
         from the reader, and a single "certificate problem" would send a developer
         with an expired certificate looking at trust settings.

         The host and never the address: a dev server URL can carry an OAuth code
         or an API key in its query. `tls_unknown_host` stands in when the address
         yields no host at all, so the sentence still reads as one.

         None of these offers to continue, and none should be given a button that
         does. The WebView documentation asks that SSL errors are not put to the
         user as a choice, and Google Play's insecure-SSL-error-handler policy
         refuses an app whose override proceeds past them. -->
    <!-- These reach the user as a Toast, which truncates. MEASURED on a landscape
         phone at API 33, twice: a 113-character message was cut at 83 rendered
         characters and a 70-character one at 74, and both times what went missing
         was the half that says what to do. So each of these stays short enough to
         render whole with a host substituted, and the advice is the shortest true
         one rather than the fullest. Why a user-installed CA does not help a page,
         when it does help git, is a paragraph rather than a toast: it is in the
         user guide, and the full reason is in logcat on every refusal. -->
    <string name="tls_blocked_untrusted">Acesso bloqueado a %1$s: certificado não confiável. Use http.</string>
    <string name="tls_blocked_hostname">Acesso bloqueado a %1$s: o certificado é de outro nome de host.</string>
    <string name="tls_blocked_date">Acesso bloqueado a %1$s: certificado expirado ou ainda não válido.</string>
    <string name="tls_blocked_invalid">Acesso bloqueado a %1$s: falha ao validar o certificado.</string>
    <string name="tls_blocked_handshake">Acesso bloqueado a %1$s: falha ao negociar a conexão segura.</string>
    <string name="tls_unknown_host">esse endereço</string>

    <!-- Shown on the page itself, not in a toast, when the restart budget is
         spent. The screen behind it read "Starting server..." and went on
         reading that for ever, so the only thing it said was the only thing
         that was no longer true. -->
    <string name="error_server_gave_up">O servidor de desenvolvimento parou e não foi possível reiniciá-lo. Seus arquivos estão seguros. Tentar de novo costuma resolver; se não resolver, feche e abra o app.</string>
    <string name="error_server_retry">Tentar novamente</string>
    <!-- The first screen of every cold start, inside the placeholder page
         MainActivity draws while the server comes up. -->
    <string name="server_starting">Iniciando o servidor…</string>
    <!-- Shown on the page, with the reload control, once the editor's renderer
         has died several times in a minute and the app stops reopening it. -->
    <string name="error_renderer_crash_loop">O editor fechou de forma inesperada várias vezes seguidas, então o VSCodroid parou de reabri-lo. Seus arquivos e o servidor não foram afetados. Fechar outros apps antes torna isso menos provável.</string>
    <string name="legal_disclaimer">O VSCodroid é compilado a partir do código-fonte do Code - OSS, sob a licença MIT.\nNão tem afiliação com a Microsoft Corporation nem é endossado por ela.\n\"Visual Studio Code\" e \"VS Code\" são marcas comerciais da Microsoft.\nUsa o registro de extensões Open VSX, não o Microsoft Marketplace.</string>

    <!-- About dialog -->
    <string name="about_title">Sobre o VSCodroid</string>
    <string name="about_version_format">Versão %s</string>
    <string name="about_licenses">Licenças</string>
    <string name="licenses_title">Licenças de código aberto</string>
    <!-- Opens the verbatim GPL and LGPL texts. Separate from the notices above
         because the copyleft binaries in this app require the licence itself to
         be handed over, not only named. -->
    <string name="licenses_full_texts">Textos das licenças</string>

    <!-- Toolchain picker (first-run) -->
    <string name="picker_title">Em que você programa?</string>
    <string name="picker_subtitle">Opcional. Toque e segure o ícone do app para adicionar ou remover depois.</string>
    <string name="picker_included">Node.js, Python e Git já estão incluídos.</string>
    <string name="picker_continue">Continuar</string>
    <string name="picker_skip">Pular</string>

    <!-- Toolchain download progress -->
    <string name="progress_title">Instalando toolchains\u2026</string>
    <string name="progress_waiting">Aguardando\u2026</string>
    <!-- How much of a download has arrived. The number is an argument rather than
         part of a literal built in Kotlin because neither half of a percentage is
         fixed across locales: the sign sits before the number in some of them, and
         the digits are drawn with a different set of glyphs in others. Passing it
         through the resource lets both follow the device's locale. -->
    <string name="progress_percent">%1$d%%</string>
    <string name="progress_installing">Instalando\u2026</string>
    <string name="progress_done">Concluído</string>
    <string name="progress_failed">Falhou</string>

    <!-- Why an install failed. "Failed" alone was the same word for a full disk,
         a dropped connection and a file the release never published, and the user
         is the one person who can act on the difference. Each of these names the
         thing they can do about it; ToolchainFailure decides which one is shown. -->
    <string name="toolchain_failed_network">Falha no download. Verifique sua conexão e tente novamente.</string>
    <string name="toolchain_failed_storage">Armazenamento insuficiente. Libere espaço e tente novamente.</string>
    <string name="toolchain_failed_not_published">Este toolchain não está na versão atual. Tente de novo depois da próxima atualização do app.</string>
    <string name="toolchain_failed_digest">O download não corresponde ao que foi publicado na versão. Tente novamente.</string>
    <string name="toolchain_failed_corrupt">O download ficou incompleto. Tente novamente.</string>
    <string name="toolchain_failed_play">O Play entrega este toolchain apenas para apps que ele mesmo instalou. Instale pela Play Store e tente novamente.</string>
    <!-- Shown when a second install of the same toolchain is declined because one is
         already running. Not a failure: the toolchain is on its way in, by the install
         that got there first, and the only thing the user needs is to stop tapping. -->
    <string name="toolchain_already_installing">Esse toolchain já está sendo instalado.</string>
    <string name="toolchain_failed_internal">A instalação falhou. Os detalhes estão no log do app.</string>
    <string name="progress_cancel">Cancelar</string>
    <string name="progress_retry">Repetir</string>

    <!-- Toolchain settings -->
    <string name="toolchain_settings_title">Toolchains</string>
    <string name="toolchain_installed">Instalado</string>
    <string name="toolchain_install">Instalar</string>
    <string name="toolchain_remove">Remover</string>
    <string name="toolchain_cancel">Cancelar</string>
    <string name="toolchain_remove_confirm_title">Remover %s?</string>
    <string name="toolchain_remove_confirm_message">Isso vai excluir todos os arquivos do %s. Você pode reinstalar quando quiser.</string>

    <!-- Launcher shortcut: in practice the only route to the toolchain screen.
         The activity is not exported and has no launcher entry, and the one
         command that could reach it through the WebView is sent by no bundled
         extension. SplashActivity.publishToolchainShortcut records both.

         The long label is the one that has to survive truncation, not the short
         one. The launcher's touch-and-hold menu shows longLabel: read off a
         device, that row renders as "Manage toolchai...", cut off mid-word. So
         any screen telling a user what to look for has to name the long label,
         which is what the Get Started walkthrough now does. -->
    <string name="shortcut_toolchains_short">Toolchains</string>
    <string name="shortcut_toolchains_long">Gerenciar toolchains</string>
    <string name="toolchain_size_download_and_installed">%1$s de download, %2$s instalado</string>
    <!-- Shown when a save could not be written out to the device folder. Names the
         consequence rather than the error: the user's next decision is whether to
         copy the file out before uninstalling, not which exception was thrown. -->
    <string name="saf_write_back_failed">%1$s não chegou à pasta do dispositivo. A única cópia está dentro do VSCodroid.</string>

    <!-- Shown once after a folder opens when documents in it could not be copied into
         the editor: a provider error, or no room left. The opposite of
         saf_write_back_failed on purpose. There the app holds the only copy; here the
         device does, and the file is simply absent from the editor. -->
    <plurals name="saf_documents_not_copied">
        <item quantity="one">%1$d arquivo não pôde ser copiado para o editor. Ele continua inalterado na pasta do dispositivo.</item>
        <item quantity="other">%1$d arquivos não puderam ser copiados para o editor. Eles continuam inalterados na pasta do dispositivo.</item>
    </plurals>
    <!-- The same shortfall when the sizes the provider reported did not fit in the space
         left. Named separately because it is the one the user can act on. -->
    <plurals name="saf_documents_not_copied_no_room">
        <item quantity="one">Espaço livre insuficiente: %1$d arquivo não pôde ser copiado para o editor. Ele continua inalterado na pasta do dispositivo.</item>
        <item quantity="other">Espaço livre insuficiente: %1$d arquivos não puderam ser copiados para o editor. Eles continuam inalterados na pasta do dispositivo.</item>
    </plurals>
    <!-- A directory deleted in the editor that was left standing in the device folder,
         because it holds documents that never reached the editor and deleting the
         directory would have taken them with it. Names the device as where the files
         are: the local copy is gone, so saf_write_back_failed's "the only copy is
         inside VSCodroid" would be backwards here. -->
    <string name="saf_directory_kept">%1$s continua na pasta do dispositivo: contém arquivos que nunca foram copiados para o editor. Exclua por lá se não precisar mais deles.</string>

    <!-- The same refusal one level down: a single document that never reached the
         editor, deleted in the editor anyway. Worded apart from saf_directory_kept
         because that one says the thing holds files, which is false of a file, and
         apart from saf_write_back_failed because the app holds nothing here at all. -->
    <string name="saf_document_kept">%1$s continua na pasta do dispositivo: o editor nunca teve uma cópia. Exclua por lá se não precisar mais.</string>

    <!-- Removing the local copy of a device folder, from the storage screen. The
         mirror named by a hash the screen holds no longer exists: the user picked it
         from a list this app built a moment earlier, so this means the folder was
         removed or re-synced in between rather than that they typed something wrong. -->
    <string name="saf_mirror_unknown">Não há cópia local dessa pasta para remover.</string>
    <!-- The reclaim gate declining. Worded as what is at stake rather than as a
         refusal, because the user's next step is to confirm and remove it anyway: the
         mirrors that hold unsynced files are exactly the ones worth the disk, since a
         folder gets large by being worked in and working in one creates files the sync
         excludes by construction. -->
    <string name="saf_mirror_not_a_copy">Alguns arquivos dessa pasta não estão na pasta do dispositivo. Remover a cópia local excluiria esses arquivos.</string>
    <!-- The rename that commits a removal was refused by the filesystem. Separate from
         saf_mirror_unknown, which says there was nothing to remove: here the copy is
         still there, whole, and trying again is worth something. -->
    <string name="saf_mirror_not_removed">Não foi possível remover a cópia local dessa pasta. Tente novamente.</string>
    <!-- Said after a removal, on the Android side rather than in the editor, because
         the recursive delete outlives the call the editor is waiting on. -->
    <string name="saf_mirror_removed">A cópia local de uma pasta do dispositivo foi removida, liberando %1$s.</string>
    <!-- The affirmative button on that confirmation. Not android.R.string.ok: the delete
         is recursive and irreversible, and "OK" beside a warning about files that exist
         nowhere else names no action, so a reader confirming quickly has nothing to read
         but the sentence they are dismissing. -->
    <string name="saf_mirror_remove">Remover</string>

    <!-- The refusals the removal guard raises before anything is deleted. They travel
         back across the bridge and the bundled extension shows them verbatim, so they
         are the user's whole explanation for a removal that did not happen. Each names
         the thing that has to change first; none of them invites a bare retry. -->
    <string name="saf_mirror_folder_open">Essa pasta está aberta no editor. Abra outra pasta primeiro.</string>
    <string name="saf_mirror_folder_opening">Essa pasta ainda está sendo aberta.</string>
    <!-- The widest of the three. A write-back drain outlives the folder switch that
         stopped it and can still be streaming out of the copy, so a restart is what
         makes the copy safe to remove rather than closing the folder. -->
    <string name="saf_mirror_folder_this_session">Essa pasta foi aberta nesta sessão. Reinicie o VSCodroid e remova-a em seguida.</string>

    <!-- Reasons a bridge call did not do what it was asked. These are returned to the
         page and rendered by the bundled extension's showErrorMessage, which is the
         only reason they are resources at all: the gate over translatable strings is a
         predicate over call shapes and cannot see a sentence that leaves through a
         return value. -->
    <!-- The caller's session token did not match. Used by both the external-URL and
         the folder-removal calls; one string because it is one situation and one
         instruction. -->
    <string name="bridge_stale_session">O VSCodroid não aceitou a solicitação. Recarregue a janela e tente novamente.</string>
    <!-- Too many storage commands already outstanding. The four that walk the disk share
         one thread with a bounded queue, so this is a wait and not a fault, and it needs
         its own sentence: bridge_stale_session above tells the reader to reload the
         window, which does not drain that thread and costs them their editor state on the
         way to waiting exactly as long. Named by AndroidBridge.STORAGE_BUSY. -->
    <string name="bridge_storage_busy">O VSCodroid está ocupado com outra solicitação de armazenamento. Tente de novo em instantes.</string>
    <!-- No Activity wired the removal callback, so nothing could have been removed.
         Distinct from a refusal with a reason: this is a mistake in the app rather
         than a state the user can act on, and saying "that folder is in use" would
         send them looking for a folder to close. -->
    <string name="bridge_reclaim_unavailable">O VSCodroid não consegue gerenciar o armazenamento das pastas do dispositivo agora.</string>
    <!-- Nothing on the device claimed the link. The one refusal the user can act on. -->
    <string name="open_url_no_handler">O VSCodroid não abriu o link. Nenhum app neste dispositivo lida com esse tipo de link.</string>
    <!-- Every other launch failure, with the class name of the exception substituted. The
         class name and never its message: ActivityNotFoundException quotes the whole
         Intent and FileUriExposedException quotes the file, so the message would hand
         the address back to the page that supplied it. -->
    <string name="open_url_failed">O VSCodroid não conseguiu abrir esse link: %1$s</string>

    <!-- A folder copied out to the device that did not arrive whole. Counts entries
         rather than naming them, because the failure is usually folder-wide and forty
         separate notices is another way of telling the user nothing. Deliberately not
         worded like saf_write_back_failed: most of the folder did arrive, so "the only
         copy is inside VSCodroid" would overstate. -->
    <plurals name="saf_upload_incomplete">
        <item quantity="one">%2$s: um item não chegou à pasta do dispositivo.</item>
        <item quantity="other">%2$s: %1$d itens não chegaram à pasta do dispositivo.</item>
    </plurals>
    <!-- The same folder stopped by the enumeration cap rather than by a refusal. Named
         separately because the cause is a limit this app chose, not the device saying
         no, and the user's next move is to copy the rest out by hand. -->
    <string name="saf_upload_capped">%1$s é grande demais para copiar por inteiro. O restante continua dentro do VSCodroid.</string>

    <!-- The Toolchains toolbar's only icon-only control, and the app's only visible
         way back out of that screen. Without it a screen reader announces an
         unlabelled button: setSupportActionBar is never called, so the framework's
         own "Navigate up" default never applies. -->
    <string name="toolchain_navigate_up">Voltar para o editor</string>

    <!-- What the toolchain picker's card says the toolchain is for. Held here
         rather than in ToolchainRegistry.ToolchainInfo, which is where the rest
         of an entry lives: the tool names inside are literal command names a
         translator must leave alone, but the sentence around them is language,
         and a Kotlin constant is the same sentence in every locale. The registry
         carries the resource id instead. displayName and shortLabel stay plain
         strings on purpose; "Ruby" and "Java 17" are the products' own names. -->
    <string name="toolchain_ruby_description">Ruby com irb, gem, bundler</string>
    <string name="toolchain_java_description">OpenJDK 17 (javac, jar, jshell)</string>

    <!-- The checkmark on a selected toolchain card. It is an ImageView with no
         text, so this is the whole of what a screen reader has to announce it. -->
    <string name="toolchain_card_selected">Selecionado</string>

    <!-- Shown on the splash screen when setup is re-running because the app was
         updated, rather than because it is being installed for the first time.
         Distinct from extracting_message so that a user who did not expect a
         wait learns why there is one. -->
    <string name="status_updating_app">Atualizando o VSCodroid…</string>

    <!-- Opening a device folder. The sync can take a while on a large folder and
         the dialog is not cancellable, so it has to say what is happening.

         The folder name is an argument rather than concatenated, because a
         translation may need it somewhere other than the middle: the quoting
         around it is part of the resource for the same reason. -->
    <string name="saf_sync_title">Abrindo a pasta</string>
    <string name="saf_sync_message">Sincronizando \"%1$s\"…</string>
    <!-- The same dialog once the file count is known. Three arguments and all of
         them positional, since a language that counts before it names would put
         %2$d and %3$d first.

         A plural rather than a string, on the total: "files" is a counted noun,
         and the languages this would be translated into inflect it on a schedule
         English does not share. The quantity is the total rather than the number
         done, because the total is the noun's own count; the running figure is
         just how far along it is. -->
    <plurals name="saf_sync_progress">
        <item quantity="one">Sincronizando \"%1$s\"\n%2$d / %3$d arquivo…</item>
        <item quantity="other">Sincronizando \"%1$s\"\n%2$d / %3$d arquivos…</item>
    </plurals>

    <!-- A folder whose SAF grant no longer holds. Nothing opens after this any
         more: the recent-folder path used to summon the system picker on a
         grant it could not use, which let a caller put the chooser in front of
         the user without asking for it, so the sentence has to carry the next
         step itself. -->
    <string name="saf_permission_expired">A permissão expirou. Selecione a pasta novamente.</string>

    <!-- A device folder that did not open. Said as one sentence per case, with the
         cause as an argument, rather than as two resources joined in Kotlin: a
         concatenation fixes cause before consequence in every language, and the
         languages this would be translated into do not all put them that way.

         Which consequence is true depends on whether the folder that was already open
         is still being written back, so the two are separate resources rather than one
         with a word swapped. Telling a user their work is not saving when it is has its
         own cost.

         The cause of the second one is the platform's own exception message, which is
         not translatable and is carried through as it stands. It is there because the
         alternative is a folder that failed to open for no stated reason. -->
    <string name="saf_sync_denied">Permissão negada.</string>
    <string name="saf_sync_failed">Não foi possível abrir a pasta: %1$s.</string>
    <string name="saf_sync_failed_other_folder_watched">%1$s A pasta que já estava aberta não foi afetada.</string>
    <string name="saf_sync_failed_no_write_back">%1$s As alterações não serão sincronizadas com essa pasta até você abri-la de novo.</string>

    <!-- Two ways a sign-in started in the browser fails to land back in the
         editor. Worded separately because the causes differ and neither is the
         user's doing: one is the editor having restarted underneath the browser,
         the other the callback arriving after its window closed. Both end in the
         same instruction because retrying is genuinely all there is to do. -->
    <string name="sign_in_editor_restarted">Não foi possível concluir o login porque o editor reiniciou. Faça login de novo.</string>
    <string name="sign_in_timed_out">O login demorou demais para ser concluído. Faça login de novo.</string>

    <!-- The About dialog's body: the version line and the legal disclaimer, which
         are separate resources because only one of them is a sentence. Joined
         here rather than in Kotlin so a translation can change the separator. -->
    <string name="about_body">%1$s\n\n%2$s</string>
    <string name="about_privacy_policy">Política de privacidade</string>
    <!-- The written offer of source that the bundled GPL and LGPL binaries
         require, reached from the licences dialog. -->
    <string name="licenses_source_code">Código-fonte</string>
    <!-- The dismiss button on every dialog that only has something to say. One
         resource for all of them: they are the same word doing the same job, and
         three copies would be three chances for a translation to disagree with
         itself. -->
    <string name="dialog_ok">OK</string>

    <!-- Shown once on the launch after a crash. The report is quoted into the
         message because the audience is developers, and truncated by the caller
         before it arrives. -->
    <string name="crash_title">O VSCodroid parou de funcionar</string>
    <string name="crash_message">O app parou de funcionar em uma sessão anterior.\n\n%1$s</string>
    <string name="crash_dismiss">Dispensar</string>
    <string name="crash_copy_report">Copiar relatório</string>
    <string name="crash_report_copied">Relatório de erro copiado para a área de transferência</string>

    <!-- Storage running out, with the space left substituted. The command name is
         quoted exactly as the palette lists it because the reader's next action
         is to type it, and it is the one part of this sentence a translator must
         leave in English. -->
    <string name="storage_low_warning">Pouco armazenamento (%1$s disponível). Execute \"VSCodroid: Manage Device Folder Storage\" na Paleta de Comandos.</string>

    <!-- An Android System WebView older than the one this app is tested against.
         Both versions are arguments: the installed one is read off the device and
         the floor is a constant in WebViewVersion, so neither can be written into
         a translation without going stale.

         The floor is substituted as %2$s rather than %2$d although it is an Int.
         It is a version number, not a quantity: nothing about the sentence
         changes when it does, and passing it as a number invites a translator to
         treat "105 and newer" as something to inflect. -->
    <string name="webview_below_minimum">O Android System WebView está na versão %1$s. O VSCodroid é testado com a versão %2$s e mais recentes, então partes do editor podem não funcionar. Atualize-o na Play Store.</string>

    <!-- The extra key row, all of it spoken rather than drawn.

         Only the descriptions are here. A key's label and the value it types are
         characters and key names, not language: "{" , ";" and "F1" mean the same
         thing in every locale, and translating either would change what the
         keyboard shows or what it types. The description is the only half a
         screen reader reads, and the only half that is a sentence.

         Every key names itself rather than falling back to its label, which is
         the point of the whole set: a reader hearing "{}" learns nothing, and
         "Curly braces" is what the key is. KeyPageConfig has no fallback left, so
         a new key without one does not compile. -->
    <string name="key_desc_tab">Tecla Tab</string>
    <string name="key_desc_escape">Tecla Escape</string>
    <string name="key_desc_ctrl">Modificador Control</string>
    <string name="key_desc_alt">Modificador Alt</string>
    <!-- Shift is named for what it does rather than by analogy with the other
         two, because it does something different. Ctrl and Alt turn the next
         character typed on the soft keyboard into a chord; Shift ALONE cannot,
         since cancelling that insertion in favour of a synthetic keystroke would
         type nothing at all, so it is spent and the soft keyboard's own
         character is inserted unchanged. Two things it does do, and the
         description names both: it decides which character the next key on THIS
         row types (Shift then / gives ?), and held together with Ctrl or Alt it
         reaches the chord after all. The interceptor in KeyInjector returns
         early only when neither of those is set, and both branches that survive
         carry shiftKey through, which is what makes Ctrl+Shift+P typable from
         the soft keyboard. The button looked and sounded identical to the two
         that work. -->
    <string name="key_desc_shift">Modificador Shift, para as teclas desta linha e para combinações com Control ou Alt</string>
    <string name="key_desc_curly_braces">Chaves</string>
    <string name="key_desc_parentheses">Parênteses</string>
    <string name="key_desc_semicolon">Ponto e vírgula</string>
    <string name="key_desc_colon">Dois-pontos</string>
    <string name="key_desc_double_quote">Aspas duplas</string>
    <string name="key_desc_forward_slash">Barra</string>
    <string name="key_desc_pipe">Barra vertical</string>
    <string name="key_desc_backtick">Crase</string>
    <string name="key_desc_ampersand">E comercial</string>
    <string name="key_desc_underscore">Sublinhado</string>
    <string name="key_desc_left_bracket">Colchete esquerdo</string>
    <string name="key_desc_right_bracket">Colchete direito</string>
    <string name="key_desc_less_than">Menor que</string>
    <string name="key_desc_greater_than">Maior que</string>
    <string name="key_desc_equals">Igual</string>
    <string name="key_desc_exclamation">Ponto de exclamação</string>
    <string name="key_desc_hash">Cerquilha</string>
    <string name="key_desc_at_sign">Arroba</string>
    <string name="key_desc_f1">Tecla de função F1</string>
    <string name="key_desc_f2">Tecla de função F2</string>
    <string name="key_desc_f3">Tecla de função F3</string>
    <string name="key_desc_f4">Tecla de função F4</string>
    <string name="key_desc_f5">Tecla de função F5</string>
    <string name="key_desc_f6">Tecla de função F6</string>
    <string name="key_desc_f7">Tecla de função F7</string>
    <string name="key_desc_f8">Tecla de função F8</string>
    <string name="key_desc_f9">Tecla de função F9</string>
    <string name="key_desc_f10">Tecla de função F10</string>
    <string name="key_desc_f11">Tecla de função F11</string>
    <string name="key_desc_f12">Tecla de função F12</string>
    <string name="key_desc_home">Tecla Home</string>
    <string name="key_desc_end">Tecla End</string>
    <string name="key_desc_page_up">Página acima</string>
    <string name="key_desc_page_down">Página abaixo</string>

    <!-- The four characters that exist only as long-press alternates. Every
         other alternate is a key on some page and reuses that key's name, so
         the popup and the row say the same thing about the same character.

         The closing parenthesis is the newest of them and the reason it is here
         at all: the `()` key sends the opening one, Shift over it cannot produce
         the closing one, and no page carries a digit row for Shift to work from,
         so the long press was the only place left to put it. -->
    <string name="key_desc_apostrophe">Apóstrofo</string>
    <string name="key_desc_backslash">Barra invertida</string>
    <string name="key_desc_tilde">Til</string>
    <string name="key_desc_closing_parenthesis">Parêntese de fechamento</string>

    <!-- Which of the key row's pages is showing. The dots below the keys carry
         this in colour alone, which leaves a screen reader nothing to read and
         a swipe with nothing to announce. -->
    <string name="key_page_indicator">Página de teclas %1$d de %2$d</string>

    <!-- The same indicator while a modifier is latched, said as one sentence
         rather than as a second description on the badge that draws the cue:
         the dots and the badge share one container, that container is the node
         a screen reader stops on, and a description on a child inside it is
         collapsed into the parent's and never read.

         The modifiers live on page 1 only and a latch survives a swipe on
         purpose, so from page 2 onwards this is the only thing that reports one.
         The last placeholder is the key names as they are written on the keys,
         which are not translated. -->
    <string name="key_page_indicator_held">Página de teclas %1$d de %2$d, %3$s pressionado</string>

    <!-- What a screen reader says after the name of a latched modifier. Kept to
         one word each because the platform reads them straight after the key's
         own description, and anything longer turns every Ctrl into a sentence. -->
    <string name="key_toggle_on">ativado</string>
    <string name="key_toggle_off">desativado</string>

    <!-- The trackpad, and the four arrows it offers to an assistive service.
         A drag is the only other way to reach them and touch exploration takes
         the gesture stream first, so these labels are the whole of that route:
         they appear in the actions menu a screen reader shows for the view. -->
    <string name="trackpad_description">Trackpad de teclas de seta. Arraste para mover o cursor.</string>
    <string name="trackpad_action_left">Mover o cursor para a esquerda</string>
    <string name="trackpad_action_right">Mover o cursor para a direita</string>
    <string name="trackpad_action_up">Mover o cursor para cima</string>
    <string name="trackpad_action_down">Mover o cursor para baixo</string>
    <!-- Saving a file the editor downloaded. These three are the whole
         user-visible outcome of the download feature, and they were written in
         Kotlin, so a values-xx/strings.xml could not reach any of them: the
         message is built into a local before it reaches the Toast, which is the
         shape check-translatable-strings.py names as the hole it cannot see. -->
    <string name="download_saved">%1$s salvo</string>
    <string name="download_cancelled">Download cancelado</string>
    <string name="download_not_saved">Não foi possível salvar %1$s</string>

    <!-- Stands in for a version the package manager would not report, the way
         tls_unknown_host stands in for an address. Written in Kotlin before, so
         one English word survived inside an otherwise translated About dialog. -->
    <string name="about_version_unknown">desconhecida</string>
</resources>
