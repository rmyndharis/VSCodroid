<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- The themed icon Android 13 and later paint in the launcher's own colours.
         The foreground artwork doubles as the silhouette: it is already the mark
         on its own, with the background supplying the colour the monochrome pass
         discards. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
