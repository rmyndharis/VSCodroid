<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately no keepScreenOn, unlike the two screens either side of it.
     Nothing is in flight here: setup has already been recorded complete
     (FirstRunSetup.markSetupComplete runs before runSetup returns), so a timeout
     costs a relaunch that lands back on this same screen, and this is the wait
     activity_splash.xml refused a window flag for because it may never be
     answered. If a sweep ever wants to add it here, that is the argument to
     rebut first. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/pickerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/picker_title"
        android:textColor="@color/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/pickerSubtitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.15" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/pickerSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:gravity="center"
        android:text="@string/picker_subtitle"
        android:textColor="@color/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pickerTitle"
        app:layout_constraintBottom_toTopOf="@+id/toolchainGrid" />

    <!-- Toolchain cards grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/toolchainGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/includedNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pickerSubtitle"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_max="300dp" />

    <!-- "Already included" note -->
    <TextView
        android:id="@+id/includedNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.7"
        android:gravity="center"
        android:text="@string/picker_included"
        android:textColor="@color/colorOnSurface"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/continueButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Continue button -->
    <Button
        android:id="@+id/continueButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/picker_continue"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toTopOf="@+id/skipButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Skip button. A real Button at 48dp, like Continue above it and Cancel on
         the next screen, and it was a wrap_content TextView with a click
         listener: about 35dp tall, so under the touch target, and announced by
         TalkBack as text rather than as a control. It is the one screen that
         decides whether the toolchain offer is ever repeated. -->
    <Button
        android:id="@+id/skipButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.6"
        android:text="@string/picker_skip"
        android:textAllCaps="false"
        android:textColor="@color/colorOnSurface"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
