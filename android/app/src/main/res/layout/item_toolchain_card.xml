<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolchainCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Toolchain name -->
        <TextView
            android:id="@+id/toolchainName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/checkmark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            Checkmark (shown when selected in PICKER mode).

            Decorative, and marked so. Selection is announced by the card
            itself: bindPickerMode sets isCheckable and isChecked on the
            MaterialCardView, which forwards both into its accessibility node,
            and the card is the focusable node here while this ImageView is not.
            A non-focusable child's label is read out as part of its clickable
            container, so leaving this important gave a selected card two
            statements of the same fact and an unselected one only the state,
            which is the spoken half of the double tick that checkedIcon = null
            already removed from the screen.

            The label stays on the element rather than being deleted: it is
            what an accessibility tool reports if the flag is ever taken off,
            and it keeps the string reachable from the layout.
        -->
        <ImageView
            android:id="@+id/checkmark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/toolchain_card_selected"
            android:importantForAccessibility="no"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <!-- Description -->
        <TextView
            android:id="@+id/toolchainDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:textColor="@color/colorOnSurface"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolchainName" />

        <!-- Size -->
        <TextView
            android:id="@+id/toolchainSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="@color/colorOnSurface"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolchainDescription" />

        <!-- Status badge (MANAGER mode: "Installed" green text) -->
        <!--
            On its own full-width row above the action button rather than beside
            it. In a two-column grid on a narrow window or at the largest font and
            display size, the action button ("Remove", "Retry") takes the whole
            inner width of the card, leaving a side-by-side 0dp badge with 20 px
            (one letter per line) or 0 px (not drawn at all). When the badge and
            progress bar are GONE, ConstraintLayout collapses them in the vertical
            chain so the action button still sits directly below toolchainSize.
        -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/colorSuccess"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolchainSize" />

        <!-- Progress bar (MANAGER mode: shown during download) -->
        <ProgressBar
            android:id="@+id/downloadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="@color/colorPrimary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statusBadge" />

        <!-- Action button (MANAGER mode: Install/Remove/Cancel/Retry) -->
        <Button
            android:id="@+id/actionButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/colorPrimaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/downloadProgress" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
