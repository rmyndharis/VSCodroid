+	/**
+	 * The dialog below types a path into the app's own storage, where a folder in the phone's
+	 * shared storage (Documents, Download, an SD card) shows no files: Android hides what other
+	 * apps saved there from a path, and only the system picker grants access. So ask which one
+	 * is meant. Resolves true once the picker took over or the question was dismissed.
+	 */
+	private async openFolderFromDevice(): Promise<boolean> {
+		if (!CommandsRegistry.getCommand(OPEN_FOLDER_FROM_DEVICE)) {
+			return false; // an unregistered id would make executeCommand wait for activation
+		}
+
+		try {
+			const { result } = await this.dialogService.prompt<boolean | undefined>({
+				type: Severity.Info,
+				message: localize('openFolderWhere', "Where is the folder?"),
+				detail: localize('openFolderWhereDetail', "A folder in Documents, Download or on an SD card needs the system picker to show all of its files."),
+				buttons: [
+					{ label: localize('openFolderOnDevice', "On the device"), run: () => true },
+					{ label: localize('openFolderInApp', "In the app's storage"), run: () => false }
+				],
+				cancelButton: { run: () => undefined }
+			});
+
+			if (result) {
+				await this.commandService.executeCommand(OPEN_FOLDER_FROM_DEVICE);
+			}
+
+			return result !== false;
+		} catch (error) {
+			// A question that cannot be shown, or a picker that cannot be started, must not take
+			// the path dialog away: it is the way into the app's own storage.
+			this.logService.warn('[FileDialogService] Open Folder from Device failed, using the path dialog', error);
+			return false;
+		}
+	}
+
