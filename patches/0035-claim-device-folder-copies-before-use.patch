+import { mainWindow } from '../../base/browser/window.js';
+import { Event } from '../../base/common/event.js';
+import { IDisposable, toDisposable } from '../../base/common/lifecycle.js';
+import { Schemas } from '../../base/common/network.js';
+import { URI } from '../../base/common/uri.js';
+import { CancellationToken } from '../../base/common/cancellation.js';
+import { IChannel } from '../../base/parts/ipc/common/ipc.js';
+import { localize } from '../../nls.js';
+
+type AndroidWindow = typeof mainWindow & {
+	AndroidBridge?: { claimWorkspacePaths(token: string, pathsJson: string): boolean };
+	__vscodroid?: { authToken?: string };
+};
+
+/** Claims resolved members before publication and mirror paths before filesystem access. */
+export async function claimSafMirrorPaths(resources: readonly URI[]): Promise<void> {
+	const browser = mainWindow as AndroidWindow;
+	if (!browser.AndroidBridge) return;
+	const paths = [...new Set(resources.filter(resource =>
+		resource.scheme === Schemas.file || resource.scheme === Schemas.vscodeRemote
+	).map(resource => resource.path))];
+	if (!paths.length) return;
+	const unavailable = () => new Error(localize('deviceFolderUnavailable', 'The local copy of this device folder is unavailable. Open the folder from the device again.'));
+	const claim = (): boolean => {
+		const token = browser.__vscodroid?.authToken;
+		if (!token) return false;
+		if (typeof browser.AndroidBridge?.claimWorkspacePaths !== 'function' ||
+			!browser.AndroidBridge.claimWorkspacePaths(token, JSON.stringify(paths))) {
+			throw unavailable();
+		}
+		return true;
+	};
+	if (claim()) return;
+	await new Promise<void>((resolve, reject) => {
+		const finish = () => {
+			try {
+				if (!claim()) return;
+				cleanup();
+				resolve();
+			} catch (error) {
+				cleanup();
+				reject(error);
+			}
+		};
+		const timer = setTimeout(() => { cleanup(); reject(unavailable()); }, 5000);
+		const cleanup = () => {
+			clearTimeout(timer);
+			mainWindow.removeEventListener('vscodroid-bridge-ready', finish);
+		};
+		mainWindow.addEventListener('vscodroid-bridge-ready', finish);
+	});
+}
+
+/** Filesystem calls outside the current root, including restored editors, need the same claim. */
+export function protectSafMirrorChannel(channel: IChannel): IChannel {
+	const resources = (arg: unknown): URI[] => Array.isArray(arg) ? arg.filter(URI.isUri) : [];
+	return {
+		async call<T>(command: string, arg?: unknown, token?: CancellationToken): Promise<T> {
+			await claimSafMirrorPaths(resources(arg));
+			return channel.call<T>(command, arg, token);
+		},
+		listen<T>(event: string, arg?: unknown): Event<T> {
+			if (event !== 'readFileStream') return channel.listen<T>(event, arg);
+			return (listener, thisArgs, disposables) => {
+				let disposed = false;
+				let subscription: IDisposable | undefined;
+				void claimSafMirrorPaths(resources(arg)).then(() => {
+					if (!disposed) subscription = channel.listen<T>(event, arg)(listener, thisArgs);
+				}).catch(error => {
+					if (!disposed) listener.call(thisArgs, error);
+				});
+				const result = toDisposable(() => { disposed = true; subscription?.dispose(); });
+				if (Array.isArray(disposables)) disposables.push(result);
+				else disposables?.add(result);
+				return result;
+			};
+		}
+	};
+}
