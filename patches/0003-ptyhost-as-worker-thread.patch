 import * as performance from './vs/base/common/performance.js';
 import { removeGlobalNodeJsModuleLookupPaths, devInjectNodeModuleLookupPath } from './bootstrap-node.js';
 import { bootstrapESM } from './bootstrap-esm.js';
+import { isMainThread, parentPort } from 'worker_threads';
+
+// Running as a worker_threads Worker instead of a child_process fork, this
+// module still has to look like a forked child to everything below: the code
+// here gates on process.send, and the entry point it loads speaks the same IPC.
+// Installing the channel before any of that runs is what lets the Pty Host and
+// the Extension Host move off Android's 32-process budget unchanged.
+//
+// In a real fork isMainThread is true and none of this happens.
+if (!isMainThread && parentPort) {
+	const port = parentPort;
+	const proc = process as unknown as {
+		send?: (message: unknown) => boolean;
+		connected?: boolean;
+		disconnect?: () => void;
+	};
+	proc.send = (message: unknown) => { port.postMessage(message); return true; };
+	proc.connected = true;
+	proc.disconnect = () => { process.emit('disconnect' as never); };
+	port.on('message', (message: unknown) => {
+		// The parent cannot close a Worker's channel the way it closes a fork's, so
+		// it asks for shutdown in-band and the module runs its normal teardown.
+		if (message && typeof message === 'object' && '__vsc_disconnect' in message) {
+			proc.connected = false;
+			process.emit('disconnect' as never);
+			return;
+		}
+		process.emit('message' as never, message as never);
+	});
+}
 
 performance.mark('code/fork/start');
 
