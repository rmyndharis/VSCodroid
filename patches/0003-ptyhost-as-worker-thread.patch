+ *--------------------------------------------------------------------------------------------*/
+
+import { ChildProcess, ForkOptions } from 'child_process';
+import { EventEmitter } from 'events';
+import { Worker } from 'worker_threads';
+
+/**
+ * How long an asked-for shutdown has before the thread is stopped anyway.
+ *
+ * An upper bound on a hang, not a budget a shutdown is expected to spend: the
+ * disconnect below is answered in milliseconds when the module is healthy, and
+ * this is only reached when it is not. It exists at all because a Worker keeps
+ * its host process alive, so a module that never exits would hold the whole
+ * server open rather than merely leaking a thread.
+ *
+ * Three seconds is chosen against what the wait is protecting. The Pty Host
+ * writes the terminal's remaining output on its way out, and the previous fixed
+ * 200ms pause was shorter than that write rather than longer than it. A deliberate
+ * app stop cannot be delayed by this either way: ProcessManager gives the whole
+ * server one second before it kills the process outright.
+ */
+const WORKER_EXIT_GRACE_MS = 3_000;
+
+/**
+ * Runs a module that expects to be a `child_process.fork` child inside a
+ * `worker_threads` Worker, presenting the caller with the small part of the
+ * `ChildProcess` surface that VS Code's IPC actually touches.
+ *
+ * Android 12+ kills background child processes past a system-wide limit of 32,
+ * counting every fork this product makes. Threads are not processes, so hosting
+ * the Pty Host and the Extension Host as Workers keeps them off that budget
+ * without changing how they are written: `bootstrap-fork` installs `process.send`
+ * over `parentPort` on the child side, so the module inside sees the IPC channel
+ * it expects.
+ *
+ * Only what the callers use is implemented -- `send`, `connected`, `kill`, `pid`
+ * and the `message`/`error`/`exit` events, plus `stdout`/`stderr` for the
+ * Extension Host. Anything else is deliberately absent rather than faked, so a
+ * new dependency on `ChildProcess` fails loudly here instead of behaving oddly on
+ * a device.
+ */
+export class WorkerAsChildProcess extends EventEmitter {
+
+	private readonly _worker: Worker;
+	private _connected = true;
+
+	constructor(modulePath: string, args: string[], options: ForkOptions) {
+		super();
+
+		// A Worker rejects --max-old-space-size in execArgv and takes it as a
+		// resource limit instead. Passing the parent's execArgv through unfiltered
+		// throws ERR_WORKER_INVALID_EXEC_ARGV before the module ever loads.
+		const execArgv: string[] = [];
+		let maxOldGenerationSizeMb: number | undefined;
+		for (const arg of options.execArgv ?? []) {
+			const match = /^--max-old-space-size=(\d+)$/.exec(arg);
+			if (match) {
+				maxOldGenerationSizeMb = parseInt(match[1], 10);
+			} else {
+				execArgv.push(arg);
+			}
+		}
+
+		this._worker = new Worker(modulePath, {
+			argv: args,
+			env: options.env as NodeJS.ProcessEnv,
+			execArgv,
+			resourceLimits: maxOldGenerationSizeMb ? { maxOldGenerationSizeMb } : undefined,
+			stdout: true,
+			stderr: true
+		});
+
+		this._worker.on('message', (message: unknown) => this.emit('message', message));
+
+		this._worker.on('error', (err: Error) => {
+			this._connected = false;
+			this.emit('error', err);
+		});
+
+		this._worker.on('exit', (code: number) => {
+			this._connected = false;
+			// A fork reports (code, signal); a Worker only has a code, and reports 1
+			// for a terminate() we asked for. Callers treat a non-zero code without
+			// SIGTERM as a crash and log it, so an intentional shutdown is reported
+			// the way those callers already understand.
+			this.emit('exit', this._killed ? 0 : code, this._killed ? this._killSignal : null);
+		});
+	}
+
+	private _killed = false;
+	private _killSignal: NodeJS.Signals | number = 'SIGTERM';
+
+	/**
+	 * The worker's thread id, NOT an OS pid -- a Worker has none, it runs inside
+	 * this process.
+	 *
+	 * Every consumer in this tree uses it as a log tag and nothing else:
+	 * `extensionHostConnection.ts` reads it once into `pid` and interpolates it
+	 * into the launch, stdout, stderr and error lines, and `ipc.cp.ts` never reads
+	 * it at all. A thread id serves that purpose exactly -- it tells two hosts
+	 * apart in one log -- which is why this returns one rather than throwing or
+	 * reporting `process.pid`.
+	 *
+	 * It must not be used for anything else. `process.kill(child.pid, ...)` would
+	 * signal an unrelated low-numbered process, and looking it up in /proc would
+	 * describe one. If you need a real pid here, a Worker is the wrong host and
+	 * the caller has to fork.
+	 */
+	get pid(): number {
+		return this._worker.threadId;
+	}
+
+	get connected(): boolean {
+		return this._connected;
+	}
+
+	get stdout(): NodeJS.ReadableStream {
+		return this._worker.stdout;
+	}
+
+	get stderr(): NodeJS.ReadableStream {
+		return this._worker.stderr;
+	}
+
+	send(message: unknown): boolean {
+		if (!this._connected) {
+			return false;
+		}
+		try {
+			this._worker.postMessage(message);
+			return true;
+		} catch (err) {
+			// postMessage throws on a structured-clone failure, where a fork would
+			// have serialised to JSON and succeeded. Reporting it as an error event
+			// keeps the caller on the path it already has for a broken channel.
+			this.emit('error', err);
+			return false;
+		}
+	}
+
+	kill(signal?: NodeJS.Signals | number): void {
+		if (this._killed) {
+			return;
+		}
+		this._killed = true;
+		this._connected = false;
+		this._killSignal = signal ?? 'SIGTERM';
+
+		// SIGKILL means stop now, and a caller reaching for it has already decided
+		// the graceful path did not work. Without the parameter this method took no
+		// signal at all, so such a caller silently got the 200ms path below -- the
+		// exact behaviour it was escalating away from, with nothing to say so.
+		// Both callers in this tree pass no signal today (ipc.cp.ts disposeClient,
+		// extensionHostConnection dispose), so this changes nothing until one of
+		// them escalates.
+		if (signal === 'SIGKILL' || signal === 9) {
+			this._worker.terminate();
+			return;
+		}
+
+		// Give the module the disconnect it would get from a closing IPC channel,
+		// so its own shutdown runs, then wait for it to go. terminate() alone would
+		// drop pending work -- for the Pty Host that means orphaned shells.
+		try {
+			this._worker.postMessage({ __vsc_disconnect: true });
+		} catch {
+			// The thread may already be gone; the deadline below covers it.
+		}
+
+		// Waited on, not timed. This used to terminate() 200ms later whatever the
+		// module was doing, which is a deadline wearing a shutdown's clothes: the
+		// Pty Host writes a terminal's remaining output as it tears down, and
+		// anything still buffered at 200ms was cut off mid-write with nothing said.
+		// The exit event is the module reporting that its teardown finished, and
+		// waiting for it costs nothing in the normal case, where it arrives first.
+		//
+		// The bound stays, because a wait with no bound is a hang: a Worker keeps
+		// its host process alive, so a module that never exits would keep the
+		// server open for good. It is stated as WORKER_EXIT_GRACE_MS rather than
+		// buried here, and it is a ceiling rather than a pause.
+		const deadline = setTimeout(() => { this._worker.terminate(); }, WORKER_EXIT_GRACE_MS);
+		this._worker.once('exit', () => clearTimeout(deadline));
+	}
+}
+
+/**
+ * Forks `modulePath`, or runs it as a Worker when `useWorker` is set.
+ *
+ * The cast is the point of the adaptor: callers keep their `ChildProcess` types
+ * and their existing code, and only the spawn site knows which it got.
+ */
+export function forkOrWorker(useWorker: boolean, fork: typeof import('child_process').fork, modulePath: string, args: string[], options: ForkOptions): ChildProcess {
+	if (useWorker) {
+		return new WorkerAsChildProcess(modulePath, args, options) as unknown as ChildProcess;
+	}
+	return fork(modulePath, args, options);
+}
