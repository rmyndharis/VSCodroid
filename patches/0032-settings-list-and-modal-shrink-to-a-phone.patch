 			height = Math.min(height, availableHeight); // Ensure the modal never exceeds available height (below the title bar)
 
+			// The minimum width must not exceed the window, and the modal is centred from the
+			// width it ends up with: resizableElement.layout raises a narrower request to its
+			// minSize, which on a phone pushed the modal past the right edge.
+			const minWidth = Math.min(effectiveMinWidth, containerDimension.width);
+			resizableElement.minSize = new Dimension(minWidth, MODAL_MIN_HEIGHT);
+			width = Math.min(Math.max(width, minWidth), containerDimension.width);
+
 			// On first layout, clamp sidebar width if it would leave the editor too narrow
 			if (isFirstLayout) {
 				isFirstLayout = false;
