+	private _onListTap(e: IListGestureEvent<CompletionItem>): void {
+		const { left, top, width, height } = dom.getDomNodePagePosition(this._list.getHTMLElement());
+		const { pageX, pageY } = e.browserEvent;
+		if (pageX < left || pageX >= left + width || pageY < top || pageY >= top + height) {
+			this.editor.trigger('touch', 'hideSuggestWidget', null);
+			return;
 		}
+		this._onListMouseDownOrTap(e);
 	}
 
