+++ b/src/vs/server/node/remoteExtensionHostAgentServer.ts
@@ -141,6 +141,22 @@ class RemoteExtensionHostAgentServer extends Disposable implements IServerAPI {
 			return void res.end('OK');
 		}
 
+		// OAuth callback
+		//
+		// Answered before the connection token check, because this request does
+		// not come from the workbench. It arrives in the system browser at the
+		// end of an OAuth redirect, and that browser holds neither the cookie
+		// nor a token in the query, so gating it turns every extension sign-in
+		// into a Forbidden page and then a silent hang.
+		//
+		// Nothing here was being protected: _handleCallback ignores the request
+		// entirely and returns a static callback.html, whose only data is the
+		// query the caller supplied itself.
+		if (pathname === '/callback' && this._webClientServer) {
+			this._webClientServer.handle(req, res, parsedUrl, pathname);
+			return;
+		}
+
 		if (!httpRequestHasValidConnectionToken(this._connectionToken, req, parsedUrl)) {
 			// invalid connection token
 			return serveError(req, res, 403, `Forbidden.`);
