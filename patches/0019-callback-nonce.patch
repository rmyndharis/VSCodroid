+++ b/src/vs/code/browser/workbench/workbench.ts
@@ -319,6 +319,18 @@ class LocalStorageURLCallbackProvider extends Disposable implements IURLCallbackP
 	create(options: Partial<UriComponents> = {}): URI {
 		const id = ++LocalStorageURLCallbackProvider.REQUEST_ID;
 		const queryParams: string[] = [`vscode-reqid=${id}`];
+
+		// A secret this request alone carries, so the Android side can tell the
+		// browser's real callback from an intent any app on the device may fire.
+		// It rides out in the redirect the extension registers, comes back in the
+		// query, and reaches the app inside the payload callback.html builds. The
+		// secret it replaces was written into that page by the server, which
