+
+import assert from 'assert';
+import * as sinon from 'sinon';
+import { DeferredPromise } from '../../../../../base/common/async.js';
+import { VSBuffer } from '../../../../../base/common/buffer.js';
+import { Event } from '../../../../../base/common/event.js';
+import { joinPath } from '../../../../../base/common/resources.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { ConfigurationScope, Extensions, IConfigurationRegistry } from '../../../../../platform/configuration/common/configurationRegistry.js';
+import { FileService } from '../../../../../platform/files/common/fileService.js';
+import { InMemoryFileSystemProvider } from '../../../../../platform/files/common/inMemoryFilesystemProvider.js';
+import { NullLogService } from '../../../../../platform/log/common/log.js';
+import { Registry } from '../../../../../platform/registry/common/platform.js';
+import { UriIdentityService } from '../../../../../platform/uriIdentity/common/uriIdentityService.js';
+import { IWorkspaceIdentifier, WorkbenchState, WorkspaceFolder } from '../../../../../platform/workspace/common/workspace.js';
+import { FolderConfiguration, WorkspaceConfiguration } from '../../browser/configuration.js';
+import { IConfigurationCache } from '../../common/configuration.js';
+
+suite('Remote configuration completion order', () => {
+    const store = ensureNoDisposablesAreLeakedInTestSuite();
+    const registry = Registry.as<IConfigurationRegistry>(Extensions.Configuration);
+    const probe = 'test.remoteCompletion';
+    setup(() => registry.registerConfiguration({ id: probe, properties: {
+        [probe]: { type: 'string', scope: ConfigurationScope.RESOURCE, default: 'default' }
+    } }));
+    teardown(() => registry.deregisterConfigurations(registry.getConfigurations().filter(c => c.id === probe)));
+
+    async function files() {
+        const log = new NullLogService();
+        const fileService = store.add(new FileService(log));
+        const provider = store.add(new InMemoryFileSystemProvider());
+        const scheme = 'vscode-remote';
+        const root = URI.from({ scheme, authority: 'test', path: '/project' });
+        const registration = fileService.registerProvider(scheme, provider);
+        await fileService.createFolder(joinPath(root, '.vscode'));
+        await fileService.writeFile(joinPath(root, '.vscode/settings.json'), VSBuffer.fromString(JSON.stringify({ [probe]: 'file' })));
+        for (const name of ['a', 'b']) {
+            await fileService.writeFile(joinPath(root, name + '.code-workspace'), VSBuffer.fromString(JSON.stringify({ folders: [{ path: name }], settings: { [probe]: name } })));
+        }
+        registration.dispose();
+        const identity = store.add(new UriIdentityService(fileService));
+        return { log, fileService, provider, root, identity, scheme };
+    }
+
+    for (const initial of [undefined, null, JSON.stringify({ [probe]: 'page' })]) {
+        test('a late folder cache cannot replace an accepted file model: ' + String(initial), async () => {
+            const f = await files();
+            const cached = new DeferredPromise<string>();
+            const cache: IConfigurationCache = { needsCaching: () => true, read: () => cached.p, write: async () => {}, remove: async () => {} };
+            const folder = new WorkspaceFolder({ uri: f.root, name: 'project', index: 0 });
+            const subject = store.add(new FolderConfiguration(true, folder, '.vscode', WorkbenchState.FOLDER, true,
+                f.fileService, f.identity, f.log, cache, initial));
+            const old = subject.loadConfiguration();
+            const changed = Event.toPromise(subject.onDidChange);
+            store.add(f.fileService.registerProvider(f.scheme, f.provider));
+            await changed;
+            const current = await subject.loadConfiguration();
+            assert.strictEqual(current.getValue(probe), 'file');
+            await cached.complete(JSON.stringify({ content: { settings: JSON.stringify({ [probe]: 'cache' }) } }));
+            assert.strictEqual((await old).getValue(probe), 'file', 'the older caller received a stale model');
+            assert.strictEqual(subject.reparse().getValue(probe), 'file', 'reparse selected the old backing object');
+        });
+    }
+
+    test('a folder cache is usable before a pending provider read completes', async () => {
+        const f = await files();
+        const cache: IConfigurationCache = { needsCaching: () => true,
+            read: async () => JSON.stringify({ content: { settings: JSON.stringify({ [probe]: 'cache' }) } }),
+            write: async () => {}, remove: async () => {} };
+        const subject = store.add(new FolderConfiguration(true, new WorkspaceFolder({ uri: f.root, name: 'project', index: 0 }),
+            '.vscode', WorkbenchState.FOLDER, true, f.fileService, f.identity, f.log, cache));
+        assert.strictEqual((await subject.loadConfiguration()).getValue(probe), 'cache');
+        assert.strictEqual(subject.reparse().getValue(probe), 'cache');
+        const changed = Event.toPromise(subject.onDidChange);
+        store.add(f.fileService.registerProvider(f.scheme, f.provider));
+        await changed;
+        assert.strictEqual((await subject.loadConfiguration()).getValue(probe), 'file');
+    });
+
+    for (const emptyB of [false, true]) {
+        test('an older provider initialization cannot install after another workspace: empty=' + emptyB, async () => {
+            const f = await files();
+            const a: IWorkspaceIdentifier = { id: 'a', configPath: joinPath(f.root, 'a.code-workspace') };
+            const b: IWorkspaceIdentifier = { id: 'b', configPath: joinPath(f.root, 'b.code-workspace') };
+            const cache: IConfigurationCache = { needsCaching: () => true,
+                read: async key => JSON.stringify({ content: key.key === 'b' && emptyB ? '' : JSON.stringify({ folders: [{ path: key.key }], settings: { [probe]: 'cached-' + key.key } }) }),
+                write: async () => {}, remove: async () => {} };
+            const subject = store.add(new WorkspaceConfiguration(cache, f.fileService, f.identity, f.log));
+            const waiting = sinon.spy(subject as unknown as { waitAndInitialize(identifier: IWorkspaceIdentifier, generation?: number): Promise<void> }, 'waitAndInitialize');
+            const entered = new DeferredPromise<void>(), release = new DeferredPromise<void>();
+            const realRead = f.provider.readFile.bind(f.provider);
+            const reads = sinon.stub(f.provider, 'readFile').callsFake(async resource => {
+                if (resource.toString() === a.configPath.toString()) { await entered.complete(); await release.p; }
+                return realRead(resource);
+            });
+            try {
+                await subject.initialize(a, true);
+                store.add(f.fileService.registerProvider(f.scheme, f.provider));
+                await entered.p;
+                const bInstalled = Event.toPromise(Event.filter(subject.onDidUpdateConfiguration, () => subject.getConfiguration().getValue(probe) === 'b'));
+                await subject.initialize(b, true);
+                await bInstalled;
+                assert.strictEqual(subject.getConfiguration().getValue(probe), 'b');
+                const updates: string[] = [];
+                store.add(subject.onDidUpdateConfiguration(() => updates.push(subject.getConfiguration().getValue(probe)!)));
+                await release.complete();
+                await waiting.returnValues[0];
+                assert.strictEqual(subject.getConfiguration().getValue(probe), 'b');
+                assert.deepStrictEqual(subject.getFolders(), [{ path: 'b' }]);
+                assert.deepStrictEqual(updates, [], 'a stale provider completion emitted a configuration update');
+            } finally { if (!release.isSettled) await release.complete(); reads.restore(); waiting.restore(); }
+        });
+    }
+});
