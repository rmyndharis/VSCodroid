+/**
+ * Call `termuxPrefixPath()`, but if the prefixed file does not exist
+ * and the same path under `/system` does, return that instead, so that
+ * `/usr/bin/env` is `/system/bin/env` when `$TERMUX__PREFIX/bin/env`
+ * is absent.
+ */
+static char *termuxPrefixPathOrSystemPath(const char *termuxPrefixDir, const char *path,
+    char *buffer, size_t bufferSize) {
+    char *prefixedPath = termuxPrefixPath(LOG_TAG, termuxPrefixDir, path, buffer, bufferSize);
+    if (prefixedPath != NULL && (strcmp(prefixedPath, path) == 0 || access(prefixedPath, F_OK) == 0)) {
+        return prefixedPath;
+    }
 
+    // Also reached with `prefixedPath == NULL`, which is a process whose
+    // environment has no `TERMUX__PREFIX` and whose compiled-in default
+    // does not exist: `/bin/sh` must still run there, as it does with no
+    // preload at all. `errno` is kept for the caller, as `access()` below
+    // overwrites it.
+    int savedErrno = errno;
+    char systemPath[PATH_MAX];
+    if (termuxPrefixPath(LOG_TAG, "/system", path, systemPath, sizeof(systemPath)) == NULL ||
+        strlen(systemPath) >= bufferSize || access(systemPath, F_OK) != 0) {
+        errno = savedErrno;
+        return prefixedPath;
+    }
 
+    strcpy(buffer, systemPath);
+    return buffer;
+}
+
